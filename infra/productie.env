# Niet-geheime productie-instellingen, in git zodat een wijziging (bijv. een ander domein)
# gewoon een PR is. Geheimen staan alleen in /opt/poetsploeg/.env op de server.
# Dit bestand wordt ná .env geladen en wint dus bij dubbele namen.
#
# Domein wisselen: zie docs/uitrol.md, "Domein wisselen". Voorlopig e-rp.nl (het oude
# ERP-domein, wijst al naar de server) tot PoetsPloeg een eigen domein heeft.

APP_NAME=PoetsPloeg
APP_URL=https://e-rp.nl
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
LOG_LEVEL=info

# Domein waar Caddy een certificaat voor haalt; moet gelijk zijn aan de host in APP_URL.
# De uitrol-workflow leest het ook voor de health-check van buitenaf.
POETSPLOEG_DOMEIN=e-rp.nl

DB_DATABASE=poetsploeg
DB_USERNAME=poetsploeg

MAIL_FROM_ADDRESS=planning@e-rp.nl
MAIL_FROM_NAME=PoetsPloeg

POETSPLOEG_GENERATE_WEEKS_AHEAD=12
