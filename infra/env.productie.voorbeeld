# Voorbeeld voor /opt/poetsploeg/.env op de server. Nooit in git met echte waarden.
#   sudo install -o uitrol -g uitrol -m 600 /dev/null /opt/poetsploeg/.env
# Vaste instellingen (APP_ENV, DB_HOST, ...) staan in infra/compose.yaml.

APP_NAME=PoetsPloeg
# Maken met: openssl rand -base64 32   (en dan "base64:" ervoor)
APP_KEY=
APP_URL=https://poetsploeg.thomasklaassen.nl
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
LOG_LEVEL=info

# Domein waar Caddy een certificaat voor haalt. Moet gelijk zijn aan de host in APP_URL.
POETSPLOEG_DOMEIN=poetsploeg.thomasklaassen.nl

DB_DATABASE=poetsploeg
DB_USERNAME=poetsploeg
# Maken met: openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Uitgaande mail. Zolang er geen SMTP-dienst is: log (mails komen dan in de containerlog).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=planning@poetsploeg.thomasklaassen.nl
MAIL_FROM_NAME=PoetsPloeg
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

POETSPLOEG_GENERATE_WEEKS_AHEAD=12
