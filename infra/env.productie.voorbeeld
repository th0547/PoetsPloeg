# Voorbeeld voor /opt/poetsploeg/.env op de server: alleen geheimen. Nooit in git met echte
# waarden. Niet-geheime instellingen staan in infra/productie.env (die wint bij dubbele namen).
#   sudo install -o uitrol -g uitrol -m 600 /dev/null /opt/poetsploeg/.env

# Maken met: openssl rand -base64 32   (en dan "base64:" ervoor)
APP_KEY=
# Maken met: openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Uitgaande mail. Zolang Brevo nog niet is ingesteld: log (mails komen dan in de containerlog).
# Met Brevo (host en poort staan in infra/productie.env): MAIL_MAILER=smtp en de SMTP-gegevens
# uit Brevo > SMTP & API > SMTP. De gebruikersnaam is de SMTP-login (eindigt op @smtp-brevo.com),
# het wachtwoord is een SMTP-sleutel (geen API-sleutel).
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=
