# /etc/systemd/system/poetsploeg-deploy.service
# Voert deploy.sh uit als gebruiker poetsploeg. Wordt gestart door poetsploeg-deploy.path.
[Unit]
Description=PoetsPloeg deploy

[Service]
Type=oneshot
User=poetsploeg
Group=poetsploeg
WorkingDirectory=/var/www/poetsploeg
ExecStart=/var/www/poetsploeg/deploy/deploy.sh
ExecStartPost=/bin/rm -f /var/www/poetsploeg/storage/app/deploy.trigger
StandardOutput=append:/var/www/poetsploeg/storage/logs/deploy.log
StandardError=append:/var/www/poetsploeg/storage/logs/deploy.log
