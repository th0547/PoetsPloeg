# /etc/systemd/system/novon-deploy.service
# Voert deploy.sh uit als gebruiker novon. Wordt gestart door novon-deploy.path.
[Unit]
Description=Novon deploy

[Service]
Type=oneshot
User=novon
Group=novon
WorkingDirectory=/var/www/novon
ExecStart=/var/www/novon/deploy/deploy.sh
ExecStartPost=/bin/rm -f /var/www/novon/storage/app/deploy.trigger
StandardOutput=append:/var/www/novon/storage/logs/deploy.log
StandardError=append:/var/www/novon/storage/logs/deploy.log
