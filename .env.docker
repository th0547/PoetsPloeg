# Wordt bij de eerste `docker compose up` gekopieerd naar .env (alleen lokaal testen).
APP_NAME=PoetsPloeg
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

# Codespaces/proxy: vertrouw X-Forwarded-* headers zodat links via https gaan.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=poetsploeg
DB_USERNAME=poetsploeg
DB_PASSWORD=poetsploeg

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=planning@poetsploeg.test
MAIL_FROM_NAME=PoetsPloeg

POETSPLOEG_GENERATE_WEEKS_AHEAD=12
