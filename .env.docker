# Wordt bij de eerste `docker compose up` gekopieerd naar .env (alleen lokaal testen).
APP_NAME=Novon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=novon
DB_USERNAME=novon
DB_PASSWORD=novon

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=planning@novon.test
MAIL_FROM_NAME=Novon

NOVON_GENERATE_WEEKS_AHEAD=12
